    },
    "sau_id": {
      "title": "Sau Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.3.0",
      "description": "Version of the BioSemAlign core schema this record conforms to.",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRecord"
    },
    "task": {
      "$ref": "#/$defs/MappingTask"
    }
  },
  "required": [
    "sau_id",
    "mapping_key",
    "source",
    "mention",
    "context",
    "attributes",
    "task",
    "provenance",
    "readiness"
  ],
  "title": "SemanticAlignmentUnit",
  "type": "object",
  "x-biosemalign-schema-version": "0.3.0"
