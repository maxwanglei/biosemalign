    "EquivalenceGroup": {
      "additionalProperties": false,
      "description": "Exact matches that permitted equivalence keys resolve to one entity.",
      "properties": {
        "conflict": {
          "default": false,
          "description": "True when the group holds two codes from one vocabulary — or, when the profile names conflict vocabularies, two codes from that pool.",
          "title": "Conflict",
          "type": "boolean"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/QualifiedCode"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "sources": {
          "description": "Independent sources asserting the matched names, canonicalized so that a redistributed atom counts once under its originating source.",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "members"
      ],
      "title": "EquivalenceGroup",
      "type": "object"
    },
    "MappingTask": {
      "additionalProperties": false,
      "description": "What this mapping is *for*.\n\nMapping purpose and desired granularity are explicit rather than implied\n(goal 3, §3.1): \"metoprolol tartrate 50 MG oral tablet\" is the right answer\nfor product-level exposure and the wrong answer for ingredient-level signal\ndetection, and only the task can distinguish them.",
      "properties": {
        "desired_granularity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Requested level, e.g. 'ingredient', 'precise_ingredient'.",
          "title": "Desired Granularity"
        },
        "mapping_intent": {
          "description": "Analytical purpose, e.g. 'ingredient_level_analysis'.",
          "title": "Mapping Intent",
          "type": "string"
        },
        "operation": {
          "description": "Task name, e.g. 'drug_normalization'.",
          "title": "Operation",
          "type": "string"
        },
        "source_terminologies": {
          "description": "Vocabularies besides the target that a source-level concept may come from; analysis-level concepts always come from the target terminology.",
          "items": {
            "type": "string"
          },
          "title": "Source Terminologies",
          "type": "array"
        },
        "target_terminology": {
          "description": "Target vocabulary, e.g. 'RxNorm'.",
          "title": "Target Terminology",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "mapping_intent",
        "target_terminology"
      ],
      "title": "MappingTask",
      "type": "object"
    },
    "MemoProvenance": {
      "additionalProperties": false,
      "description": "Marks a decision whose proposal and evidence were reused from the memo.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "original_run_id": {
          "description": "Run that resolved the input first.",
          "title": "Original Run Id",
          "type": "string"
        },
        "stored_at": {
          "format": "date-time",
          "title": "Stored At",
          "type": "string"
        }
      },
      "required": [
        "key",
        "original_run_id",
        "stored_at"
      ],
      "title": "MemoProvenance",
      "type": "object"
    },
    "Mention": {
      "additionalProperties": false,
      "description": "The span to be mapped, plus its provisional typing (§5.5).",
      "properties": {
        "detection_method": {
          "default": "user_specified",
          "description": "How this span was identified, e.g. 'user_specified', 'profile_default'.",
          "title": "Detection Method",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "normalized_text": {
          "description": "Whitespace-collapsed, case-folded form.",
          "title": "Normalized Text",
          "type": "string"
        },
        "retrieval_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canonicalized form that retrievers query instead of ``text``, set by transform operators. It never replaces the source mention: identity claims such as EXACT are still judged against ``text``.",
          "title": "Retrieval Text"
        },
        "semantic_types": {
          "description": "Provisional types. More than one is permitted and expected when the evidence is genuinely ambiguous (§5.5) — collapsing to a single guess here would hide the ambiguity from the adjudicator.",
          "items": {
            "$ref": "#/$defs/SemanticType"
          },
          "title": "Semantic Types",
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Character offset into the source text.",
          "title": "Start"
        },
        "text": {
          "description": "The mention exactly as it appears in the source.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "normalized_text"
      ],
      "title": "Mention",
      "type": "object"
    },
