      "type": "object"
    },
    "ReadinessStatus": {
      "description": "Whether an SAU carries enough information to be mapped (§5.8).",
      "enum": [
        "READY_FOR_MAPPING",
        "READY_WITH_LIMITED_CONTEXT",
        "INSUFFICIENT_CONTEXT",
        "NEEDS_DECOMPOSITION",
        "UNSUPPORTED_INPUT"
      ],
      "title": "ReadinessStatus",
      "type": "string"
    },
    "ResolutionTrace": {
      "additionalProperties": false,
      "description": "The path one SAU took through a workflow cascade.\n\nRecorded per decision rather than per run: tier attribution is what makes\nper-tier coverage and precision measurable, and a pass-through reason is\nthe only explanation of why a later, costlier tier was needed.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/TierAttempt"
          },
          "minItems": 1,
          "title": "Attempts",
          "type": "array"
        },
        "resolved_by_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tier whose proposal was validated; None when every tier passed.",
          "title": "Resolved By Tier"
        },
        "withheld_context": {
          "default": [],
          "description": "Context fields hidden from proposers by the profile's blinding policy.",
          "items": {
            "type": "string"
          },
          "title": "Withheld Context",
          "type": "array"
        }
      },
      "required": [
        "attempts"
      ],
      "title": "ResolutionTrace",
      "type": "object"
    },
    "ResourceMode": {
      "description": "External-resource access policy for a run (§20.3).",
      "enum": [
        "ONLINE",
        "CACHE_PREFER",
        "FROZEN",
        "OFFLINE"
      ],
      "title": "ResourceMode",
      "type": "string"
    },
    "ResourceProvenance": {
      "additionalProperties": false,
      "description": "One external knowledge resource as it was used during this run.",
      "properties": {
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest of the local snapshot served, when the resource is a file bundle.",
          "title": "Content Sha256"
        },
        "mode": {
          "$ref": "#/$defs/ResourceMode",
          "default": "ONLINE"
        },
        "network_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Network Calls",
          "type": "integer"
        },
        "provider_name": {
          "description": "Provider implementation, e.g. 'rxnav'.",
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "provider_version": {
          "description": "Version of the provider code.",
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "resource_name": {
          "description": "Registry name, e.g. 'RxNorm'.",
          "minLength": 1,
          "title": "Resource Name",
          "type": "string"
        },
        "terminology_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vocabulary release identifier, e.g. the RxNorm release date.",
          "title": "Terminology Release"
        }
      },
      "required": [
        "resource_name",
        "provider_name",
        "provider_version"
      ],
      "title": "ResourceProvenance",
      "type": "object"
    },
    "SemanticType": {
      "description": "Provisional entity type assigned by the SAU Builder (§5.5).\n\nThis is a *provisional* typing decision, deliberately separate from concept\nidentity. Module 3 performs the final concept selection.",
      "enum": [
        "drug",
        "drug_product",
        "drug_ingredient",
        "metabolite",
        "disease",
        "phenotype",
        "clinical_finding",
        "laboratory_test",
        "laboratory_result",
        "gene",
        "protein",
        "enzyme",
        "assay",
        "biological_system",
        "anatomical_structure",
        "procedure",
        "species",
        "dose",
        "unit",
        "temporal_expression",
        "unknown"
      ],
      "title": "SemanticType",
      "type": "string"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "The originating record, preserved verbatim.\n\n``raw_value`` is never normalized, trimmed, or case-folded. Downstream\nstages work on derived copies; this field is the audit anchor that lets a\nreviewer see exactly what the source system reported (§5.4, Milestone 2\nexit criterion 2).",
      "properties": {
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Name"
        },
        "extensions": {
          "additionalProperties": true,
          "description": "Project-specific fields. The core schema never interprets these; they travel with the record and are preserved in output.",
          "title": "Extensions",
          "type": "object"
        },
        "raw_value": {
          "description": "The original value, byte-for-byte as received.",
          "title": "Raw Value",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Identifier of the source row, e.g. a FAERS primaryid.",
          "title": "Record Id"
        },
        "row": {
          "additionalProperties": true,
          "description": "Neighbouring fields from the same record, unmodified.",
          "title": "Row",
          "type": "object"
        },
        "source_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Originating system, e.g. 'FAERS', 'MarketScan'.",
          "title": "Source System"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "table_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Name"
        }
      },
      "required": [
        "source_type",
        "raw_value"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "SourceType": {
      "description": "How the caller is handing us the thing to be mapped (§5.2).",
      "enum": [
        "structured_field",
        "structured_record",
        "structured_batch",
        "unstructured_text"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TierAttempt": {
      "additionalProperties": false,
      "description": "What one tier did with an SAU, and why it passed if it did.\n\nA tier that assesses concordance also records every exact match it saw —\neach vocabulary's code, grouped by equivalence, linked to the target or\nnot. Coding is never lost when a tier passes: the final artifact carries\nonly the last tier's package, but every tier's matches stay here.",
      "properties": {
        "concordance_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConcordanceState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "exact_matches": {
          "default": [],
          "description": "Every exact match of this tier's package, grouped by equivalence.",
          "items": {
            "$ref": "#/$defs/EquivalenceGroup"
          },
          "title": "Exact Matches",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/TierOutcome"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "tier": {
          "minLength": 1,
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "outcome"
      ],
      "title": "TierAttempt",
      "type": "object"
    },
    "TierOutcome": {
      "description": "What one tier of a workflow cascade did with an SAU (v0.2).",
      "enum": [
        "RESOLVED",
        "PASSED"
      ],
      "title": "TierOutcome",
      "type": "string"
    },
    "TierProvenance": {
      "additionalProperties": false,
      "description": "The operators one cascade tier runs, in execution order.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorProvenance"
          },
          "title": "Operators",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "TierProvenance",
      "type": "object"
    },
    "WorkflowProvenance": {
      "additionalProperties": false,
      "description": "The complete operator configuration a decision was produced under.\n\n``workflow_id`` is a digest of everything else here, so two decisions can\nbe compared for \"same workflow\" without diffing operator lists.",
      "properties": {
        "target_spec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The target spec decisions followed, e.g. 'rxnorm@1.0' (v0.3).",
          "title": "Target Spec"
        },
        "target_spec_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Spec Sha256"
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/TierProvenance"
          },
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        },
        "validators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorProvenance"
          },
          "title": "Validators",
          "type": "array"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "tiers"
      ],
      "title": "WorkflowProvenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One thing to be mapped, with its context preserved (§11.2).",
  "properties": {
