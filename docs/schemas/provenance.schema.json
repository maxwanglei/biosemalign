{
  "$defs": {
    "MemoProvenance": {
      "additionalProperties": false,
      "description": "Marks a decision whose proposal and evidence were reused from the memo.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "original_run_id": {
          "description": "Run that resolved the input first.",
          "title": "Original Run Id",
          "type": "string"
        },
        "stored_at": {
          "format": "date-time",
          "title": "Stored At",
          "type": "string"
        }
      },
      "required": [
        "key",
        "original_run_id",
        "stored_at"
      ],
      "title": "MemoProvenance",
      "type": "object"
    },
    "ModelProvenance": {
      "additionalProperties": false,
      "description": "The adjudicator that produced the proposal.\n\nPopulated for the deterministic adjudicator too — \"which rules ran\" is as\nmuch a reproducibility question as \"which checkpoint ran\".",
      "properties": {
        "backend": {
          "description": "Adjudicator backend, e.g. 'deterministic', 'vllm', 'mock'.",
          "title": "Backend",
          "type": "string"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "generation_parameters": {
          "additionalProperties": true,
          "title": "Generation Parameters",
          "type": "object"
        },
        "model_checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Checkpoint"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "backend"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "OperatorProvenance": {
      "additionalProperties": false,
      "description": "One configured operator in a workflow (v0.2).",
      "properties": {
        "kind": {
          "description": "Operator kind: transform, retrieve, fuse, propose, validate.",
          "title": "Kind",
          "type": "string"
        },
        "op_id": {
          "minLength": 1,
          "title": "Op Id",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "op_id",
        "version"
      ],
      "title": "OperatorProvenance",
      "type": "object"
    },
    "ResolutionTrace": {
      "additionalProperties": false,
      "description": "The path one SAU took through a workflow cascade.\n\nRecorded per decision rather than per run: tier attribution is what makes\nper-tier coverage and precision measurable, and a pass-through reason is\nthe only explanation of why a later, costlier tier was needed.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/TierAttempt"
          },
          "minItems": 1,
          "title": "Attempts",
          "type": "array"
        },
        "resolved_by_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tier whose proposal was validated; None when every tier passed.",
          "title": "Resolved By Tier"
        },
        "withheld_context": {
          "default": [],
          "description": "Context fields hidden from proposers by the profile's blinding policy.",
          "items": {
            "type": "string"
          },
          "title": "Withheld Context",
          "type": "array"
        }
      },
      "required": [
        "attempts"
      ],
      "title": "ResolutionTrace",
      "type": "object"
    },
    "ResourceMode": {
      "description": "External-resource access policy for a run (§20.3).",
      "enum": [
        "ONLINE",
        "CACHE_PREFER",
        "FROZEN",
        "OFFLINE"
      ],
      "title": "ResourceMode",
      "type": "string"
    },
    "ResourceProvenance": {
      "additionalProperties": false,
      "description": "One external knowledge resource as it was used during this run.",
      "properties": {
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest of the local snapshot served, when the resource is a file bundle.",
          "title": "Content Sha256"
        },
        "mode": {
          "$ref": "#/$defs/ResourceMode",
          "default": "ONLINE"
        },
        "network_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Network Calls",
          "type": "integer"
        },
        "provider_name": {
          "description": "Provider implementation, e.g. 'rxnav'.",
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "provider_version": {
          "description": "Version of the provider code.",
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "resource_name": {
          "description": "Registry name, e.g. 'RxNorm'.",
          "minLength": 1,
          "title": "Resource Name",
          "type": "string"
        },
        "terminology_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vocabulary release identifier, e.g. the RxNorm release date.",
          "title": "Terminology Release"
        }
      },
      "required": [
        "resource_name",
        "provider_name",
        "provider_version"
      ],
      "title": "ResourceProvenance",
      "type": "object"
    },
    "TierAttempt": {
      "additionalProperties": false,
      "description": "What one tier did with an SAU, and why it passed if it did.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "outcome": {
          "$ref": "#/$defs/TierOutcome"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "tier": {
          "minLength": 1,
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "outcome"
      ],
      "title": "TierAttempt",
      "type": "object"
    },
    "TierOutcome": {
      "description": "What one tier of a workflow cascade did with an SAU (v0.2).",
      "enum": [
        "RESOLVED",
        "PASSED"
      ],
      "title": "TierOutcome",
      "type": "string"
    },
    "TierProvenance": {
      "additionalProperties": false,
      "description": "The operators one cascade tier runs, in execution order.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorProvenance"
          },
          "title": "Operators",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "TierProvenance",
      "type": "object"
    },
    "WorkflowProvenance": {
      "additionalProperties": false,
      "description": "The complete operator configuration a decision was produced under.\n\n``workflow_id`` is a digest of everything else here, so two decisions can\nbe compared for \"same workflow\" without diffing operator lists.",
      "properties": {
        "tiers": {
          "items": {
            "$ref": "#/$defs/TierProvenance"
          },
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        },
        "validators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorProvenance"
          },
          "title": "Validators",
          "type": "array"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "tiers"
      ],
      "title": "WorkflowProvenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Everything needed to explain or reproduce one decision (§17.3).",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "description": "Project-specific fields. The core schema never interprets these; they travel with the record and are preserved in output.",
      "title": "Extensions",
      "type": "object"
    },
    "human_review_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set once the record has been through AL-MedLit review.",
      "title": "Human Review Status"
    },
    "identifier_hmac_key_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Non-secret fingerprint of the key used for SAU and mapping identifiers.",
      "title": "Identifier Hmac Key Fingerprint"
    },
    "memo": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "package_version": {
      "title": "Package Version",
      "type": "string"
    },
    "profile_name": {
      "title": "Profile Name",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolutionTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceProvenance"
      },
      "title": "Resources",
      "type": "array"
    },
    "retriever_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retriever Version"
    },
    "routing_policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Routing Policy Version"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.3.0",
      "description": "Version of the BioSemAlign core schema this record conforms to.",
      "title": "Schema Version",
      "type": "string"
    },
    "source_adapter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Adapter"
    },
    "source_adapter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Adapter Version"
    },
    "validation_rules_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Rules Version"
    },
    "workflow": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "package_version",
    "profile_name",
    "profile_version"
  ],
  "title": "Provenance",
  "type": "object",
  "x-biosemalign-schema-version": "0.3.0"
}
