{
  "$defs": {
    "ConceptStatus": {
      "description": "Lifecycle state of a terminology concept (§8.1).\n\nValues mirror the states RxNav's ``historystatus`` endpoint reports so the\nprovider layer does not have to lose information on the way in.",
      "enum": [
        "active",
        "not_current",
        "remapped",
        "quantified",
        "obsolete",
        "never_active",
        "unknown"
      ],
      "title": "ConceptStatus",
      "type": "string"
    },
    "DecisionType": {
      "description": "Top-level outcome of adjudication (§11.5).",
      "enum": [
        "MAPPED",
        "MULTI_CONCEPT_MAPPED",
        "NO_VALID_MAPPING",
        "INSUFFICIENT_CONTEXT",
        "ABSTAINED"
      ],
      "title": "DecisionType",
      "type": "string"
    },
    "RelationshipType": {
      "description": "How the selected target concept relates to the source (§7.3).\n\nThe values below the divider are reserved for later phenotype and\ncross-species work and are rejected by the v0.1 FAERS profile.",
      "enum": [
        "EXACT",
        "TARGET_BROADER_THAN_SOURCE",
        "TARGET_NARROWER_THAN_SOURCE",
        "CROSS_VOCABULARY_EQUIVALENT",
        "COMPONENT_OF",
        "MULTIPLE_COMPONENTS_REQUIRED",
        "RELATED_NOT_EQUIVALENT",
        "UNSUPPORTED_MAPPING",
        "INSUFFICIENT_CONTEXT",
        "POTENTIAL_CLINICAL_MANIFESTATION",
        "MECHANISTICALLY_RELATED",
        "CROSS_SPECIES_RELATED",
        "SPECIES_SPECIFIC"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "SelectedConcept": {
      "additionalProperties": false,
      "description": "One concept chosen from the candidate set.",
      "properties": {
        "concept_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept Class"
        },
        "concept_id": {
          "title": "Concept Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "relationship_to_source": {
          "$ref": "#/$defs/RelationshipType",
          "default": "EXACT"
        },
        "status": {
          "$ref": "#/$defs/ConceptStatus",
          "default": "unknown"
        },
        "vocabulary": {
          "title": "Vocabulary",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "label",
        "vocabulary"
      ],
      "title": "SelectedConcept",
      "type": "object"
    },
    "SemanticLoss": {
      "additionalProperties": false,
      "description": "Information discarded by mapping to a coarser concept (§8.2, goal 7).",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SemanticLossKind"
        },
        "source_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source detail that the target concept does not carry.",
          "title": "Source Value"
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "title": "SemanticLoss",
      "type": "object"
    },
    "SemanticLossKind": {
      "description": "What was dropped when a source was mapped to a coarser concept (§8.2).\n\nThe design document types ``semantic_loss`` as ``list[str]``. It is\nstructured here instead so that \"how often does ingredient-level analysis\ndiscard route?\" is a query rather than a string search.",
      "enum": [
        "strength",
        "dose_form",
        "route",
        "salt_form",
        "brand_identity",
        "combination_component",
        "specificity",
        "assertion_status",
        "temporality",
        "anatomical_site",
        "specimen",
        "unit",
        "other"
      ],
      "title": "SemanticLossKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What the adjudicator proposes, before validation (§7.4).\n\nReferenced throughout the design (§7.4, Milestone 5) but never given a\nschema; defined here as the pre-validation counterpart of\n:class:`AlignmentDecision`.",
  "properties": {
    "analysis_level_concept": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectedConcept"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The coarser concept the analysis will actually group on."
    },
    "decision": {
      "$ref": "#/$defs/DecisionType"
    },
    "evidence_references": {
      "description": "Identifiers of the knowledge statements this proposal relied on.",
      "items": {
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "description": "Project-specific fields. The core schema never interprets these; they travel with the record and are preserved in output.",
      "title": "Extensions",
      "type": "object"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "preserved_attributes": {
      "additionalProperties": true,
      "title": "Preserved Attributes",
      "type": "object"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "relationship_to_source": {
      "$ref": "#/$defs/RelationshipType"
    },
    "requested_human_review": {
      "default": false,
      "title": "Requested Human Review",
      "type": "boolean"
    },
    "sau_id": {
      "title": "Sau Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.3.0",
      "description": "Version of the BioSemAlign core schema this record conforms to.",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_concepts": {
      "items": {
        "$ref": "#/$defs/SelectedConcept"
      },
      "title": "Selected Concepts",
      "type": "array"
    },
    "semantic_loss": {
      "items": {
        "$ref": "#/$defs/SemanticLoss"
      },
      "title": "Semantic Loss",
      "type": "array"
    },
    "source_level_concept": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectedConcept"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The concept matching the source at its own granularity."
    },
    "unsupported_inferences": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported Inferences",
      "type": "array"
    }
  },
  "required": [
    "sau_id",
    "decision",
    "relationship_to_source"
  ],
  "title": "AlignmentProposal",
  "type": "object",
  "x-biosemalign-schema-version": "0.3.0"
}
