{
  "$defs": {
    "ModelProvenance": {
      "additionalProperties": false,
      "description": "The adjudicator that produced the proposal.\n\nPopulated for the deterministic adjudicator too — \"which rules ran\" is as\nmuch a reproducibility question as \"which checkpoint ran\".",
      "properties": {
        "backend": {
          "description": "Adjudicator backend, e.g. 'deterministic', 'vllm', 'mock'.",
          "title": "Backend",
          "type": "string"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "generation_parameters": {
          "additionalProperties": true,
          "title": "Generation Parameters",
          "type": "object"
        },
        "model_checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Checkpoint"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "backend"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "OperatorProvenance": {
      "additionalProperties": false,
      "description": "One configured operator in a workflow (v0.2).",
      "properties": {
        "kind": {
          "description": "Operator kind: transform, retrieve, fuse, propose, validate.",
          "title": "Kind",
          "type": "string"
        },
        "op_id": {
          "minLength": 1,
          "title": "Op Id",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "op_id",
        "version"
      ],
      "title": "OperatorProvenance",
      "type": "object"
    },
    "ResourceMode": {
      "description": "External-resource access policy for a run (§20.3).",
      "enum": [
        "ONLINE",
        "CACHE_PREFER",
        "FROZEN",
        "OFFLINE"
      ],
      "title": "ResourceMode",
      "type": "string"
    },
    "ResourceProvenance": {
      "additionalProperties": false,
      "description": "One external knowledge resource as it was used during this run.",
      "properties": {
        "accessed_at": {
          "format": "date-time",
          "title": "Accessed At",
          "type": "string"
        },
        "api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Digest of the local snapshot served, when the resource is a file bundle.",
          "title": "Content Sha256"
        },
        "mode": {
          "$ref": "#/$defs/ResourceMode",
          "default": "ONLINE"
        },
        "network_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Network Calls",
          "type": "integer"
        },
        "provider_name": {
          "description": "Provider implementation, e.g. 'rxnav'.",
          "minLength": 1,
          "title": "Provider Name",
          "type": "string"
        },
        "provider_version": {
          "description": "Version of the provider code.",
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "resource_name": {
          "description": "Registry name, e.g. 'RxNorm'.",
          "minLength": 1,
          "title": "Resource Name",
          "type": "string"
        },
        "terminology_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vocabulary release identifier, e.g. the RxNorm release date.",
          "title": "Terminology Release"
        }
      },
      "required": [
        "resource_name",
        "provider_name",
        "provider_version"
      ],
      "title": "ResourceProvenance",
      "type": "object"
    },
    "TierProvenance": {
      "additionalProperties": false,
      "description": "The operators one cascade tier runs, in execution order.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorProvenance"
          },
          "title": "Operators",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "TierProvenance",
      "type": "object"
    },
    "TierTiming": {
      "additionalProperties": false,
      "description": "Work one cascade tier did during a run.\n\nTimings live in the manifest, never in artifacts: wall-clock time differs\nbetween identical runs and would break artifact reproducibility.",
      "properties": {
        "attempts": {
          "description": "SAUs the tier was asked to resolve.",
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "resolved": {
          "description": "SAUs the tier resolved rather than passed.",
          "minimum": 0,
          "title": "Resolved",
          "type": "integer"
        },
        "seconds": {
          "description": "Wall-clock time spent in the tier.",
          "minimum": 0.0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "attempts",
        "resolved",
        "seconds"
      ],
      "title": "TierTiming",
      "type": "object"
    },
    "WorkflowProvenance": {
      "additionalProperties": false,
      "description": "The complete operator configuration a decision was produced under.\n\n``workflow_id`` is a digest of everything else here, so two decisions can\nbe compared for \"same workflow\" without diffing operator lists.",
      "properties": {
        "tiers": {
          "items": {
            "$ref": "#/$defs/TierProvenance"
          },
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        },
        "validators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorProvenance"
          },
          "title": "Validators",
          "type": "array"
        },
        "workflow_id": {
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "tiers"
      ],
      "title": "WorkflowProvenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Configuration and content fingerprints needed to audit a completed run.",
  "properties": {
    "adjudicator_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudicator Version"
    },
    "cache_retention_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Retention Days"
    },
    "cache_snapshot_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Snapshot Sha256"
    },
    "code_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Commit"
    },
    "code_tree_sha256": {
      "title": "Code Tree Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "dependency_fingerprint": {
      "title": "Dependency Fingerprint",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dependency Lock Sha256"
    },
    "extensions": {
      "additionalProperties": true,
      "description": "Project-specific fields. The core schema never interprets these; they travel with the record and are preserved in output.",
      "title": "Extensions",
      "type": "object"
    },
    "identifier_hmac_key_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identifier Hmac Key Fingerprint"
    },
    "input_sha256": {
      "title": "Input Sha256",
      "type": "string"
    },
    "manifest_version": {
      "default": "1.0.0",
      "title": "Manifest Version",
      "type": "string"
    },
    "memo_hits": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Decisions finalized from the persistent crosswalk memo.",
      "title": "Memo Hits"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_retention_policy_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Declared site policy for output retention. BioSemAlign records this value but does not delete research outputs without an explicit operator workflow.",
      "title": "Output Retention Policy Days"
    },
    "output_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Sha256",
      "type": "object"
    },
    "package_version": {
      "title": "Package Version",
      "type": "string"
    },
    "profile_name": {
      "title": "Profile Name",
      "type": "string"
    },
    "profile_sha256": {
      "title": "Profile Sha256",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "record_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Record Counts",
      "type": "object"
    },
    "registry_sha256": {
      "title": "Registry Sha256",
      "type": "string"
    },
    "resource_endpoints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Resource Endpoints",
      "type": "object"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceProvenance"
      },
      "title": "Resources",
      "type": "array"
    },
    "routing_policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Routing Policy Version"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.3.0",
      "description": "Version of the BioSemAlign core schema this record conforms to.",
      "title": "Schema Version",
      "type": "string"
    },
    "settings_sha256": {
      "title": "Settings Sha256",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tier_timings": {
      "additionalProperties": {
        "$ref": "#/$defs/TierTiming"
      },
      "description": "Per-tier work in this invocation; a resumed run reports only its own.",
      "title": "Tier Timings",
      "type": "object"
    },
    "validation_rules_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Rules Version"
    },
    "workflow": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "working_tree_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Working Tree Dirty"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "completed_at",
    "package_version",
    "code_tree_sha256",
    "dependency_fingerprint",
    "profile_name",
    "profile_version",
    "profile_sha256",
    "registry_sha256",
    "settings_sha256",
    "input_sha256"
  ],
  "title": "ResearchRunManifest",
  "type": "object",
  "x-biosemalign-schema-version": "0.3.0"
}
